<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>co.edu.sena</groupId>
    <artifactId>farmaweb</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>

    <name>FarmaWeb - Sistema de Gestion de Farmacia en Linea</name>
    <description>
        Modulos del software del proyecto formativo GA7-220501096-AA2-EV01.
        Arquitectura en tres capas (IGU / Logica / Persistencia) con Servlets, JSP y JDBC.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <version.tomcat>10.1.30</version.tomcat>

        <!--
            Carpeta de trabajo de Tomcat, obligatoriamente sin tildes, enies ni
            guiones especiales.

            La ruta de este proyecto contiene caracteres no ASCII (la O con
            tilde de "EJECUCION" y guiones U+2010 en el nombre de la evidencia).
            Al construir la linea de comandos que arranca Tomcat esos caracteres
            se corrompen y el servidor falla con ClassNotFoundException de
            org.apache.catalina.startup.Bootstrap. Instalando y ejecutando el
            servidor desde una ruta ASCII el problema desaparece.
        -->
        <dir.tomcat>C:/farmaweb-servidor</dir.tomcat>
    </properties>

    <dependencies>

        <!-- API de Servlets (la provee el contenedor Tomcat, no se empaqueta) -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- API de JSP (la provee el contenedor Tomcat, no se empaqueta) -->
        <dependency>
            <groupId>jakarta.servlet.jsp</groupId>
            <artifactId>jakarta.servlet.jsp-api</artifactId>
            <version>3.1.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- JSTL 3.0: etiquetas estandar usadas en las paginas JSP -->
        <dependency>
            <groupId>jakarta.servlet.jsp.jstl</groupId>
            <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.web</groupId>
            <artifactId>jakarta.servlet.jsp.jstl</artifactId>
            <version>3.0.1</version>
        </dependency>

        <!-- Controlador JDBC de MySQL, compatible tambien con MariaDB de XAMPP -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
        </dependency>

    </dependencies>

    <build>
        <finalName>farmaweb</finalName>

        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>

            <!--
                Tomcat embebido: "mvn cargo:run" descarga Tomcat 10.1, despliega
                la aplicacion y la publica en http://localhost:8080/farmaweb
                No requiere instalar Tomcat manualmente.
            -->
            <plugin>
                <groupId>org.codehaus.cargo</groupId>
                <artifactId>cargo-maven3-plugin</artifactId>
                <version>1.10.15</version>
                <configuration>
                    <container>
                        <containerId>tomcat10x</containerId>
                        <zipUrlInstaller>
                            <url>https://archive.apache.org/dist/tomcat/tomcat-10/v${version.tomcat}/bin/apache-tomcat-${version.tomcat}.zip</url>
                            <downloadDir>${dir.tomcat}/descargas</downloadDir>
                            <extractDir>${dir.tomcat}/instalacion</extractDir>
                        </zipUrlInstaller>
                    </container>
                    <configuration>
                        <home>${dir.tomcat}/tomcat10x</home>
                        <properties>
                            <cargo.servlet.port>8080</cargo.servlet.port>
                        </properties>
                    </configuration>
                    <deployables>
                        <deployable>
                            <groupId>co.edu.sena</groupId>
                            <artifactId>farmaweb</artifactId>
                            <type>war</type>
                            <properties>
                                <context>farmaweb</context>
                            </properties>
                        </deployable>
                    </deployables>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
